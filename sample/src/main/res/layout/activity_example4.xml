<LinearLayout
    android:layout_width="345dp"
    android:layout_height="wrap_content"
    android:background="@drawable/roundedchart"
    android:elevation="8px"
    android:gravity="center"
    android:layout_gravity="center">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginRight="5dp"
            >
            <ImageView
                android:id="@+id/butt"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/l"
                android:visibility="invisible" />
            <ImageView
                android:id="@+id/topmid"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/x"
                android:visibility="invisible" />
            <ImageView
                android:id="@+id/buttmid"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/x1"
                android:visibility="invisible" />
            <ImageView
                android:id="@+id/leFt"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/l2"
                android:visibility="invisible" />
            <ImageView
                android:id="@+id/twotop"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/k2"
                android:visibility="invisible" />
            <ImageView
                android:id="@+id/twobutt"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/k"
                android:visibility="invisible" />
            <ImageView
                android:id="@+id/top"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/l3"
                android:visibility="invisible" />
        </RelativeLayout>
    <com.github.mikephil.charting.charts.PieChart
        android:layout_gravity="center"
        android:id="@+id/pichart"
        android:layout_width="205dp"
        android:layout_height="167dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp" />
    </LinearLayout>
</LinearLayout>
    <com.polidea.rxandroidble2.sample.example4_characteristic.CustomLineChart
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="268dp"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/roundedchart"
        android:elevation="8px"
        tools:layout_editor_absoluteX="3dp"
        tools:layout_editor_absoluteY="303dp" />

    <ListView

        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"

        android:background="@drawable/custom_list_view"
        android:elevation="20dp"></ListView>
    <!--</androidx.core.widget.NestedScrollView>
-->
</LinearLayout>