<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mainlogin"
    android:background="#ffff">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">
        <!--       <ImageView
                   android:layout_width="250dp"
                   android:layout_height="110dp"
                   android:src="@drawable/behyarlogo"
            />-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >
            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:text="@string/login"
                android:textColor="#040303"
                android:textAllCaps="false"
                android:background="@drawable/border"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:background="@drawable/border"
                android:text="@string/SignUp"
                android:textColor="#040303"
                android:textAllCaps="false"
                />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/userid"
            android:textSize="25dp"
            android:layout_gravity="left"
            android:layout_marginLeft="40dp"
            android:textStyle="bold"
            android:textColor="#040303"
            />
        <EditText
            android:inputType="text"
            android:layout_width="250dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:padding="7dp"
            android:textSize="18sp"
            android:textColorHint="#61677A"
            android:textColor="#61677A"
            android:layout_marginBottom="10dp"
            android:background="@drawable/edit"
            android:hint="@string/Email"
            android:id="@+id/username"
            />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"

            app:passwordToggleTint="#61677A"
            >
            <EditText
                android:layout_width="250dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:id="@+id/password"
                android:hint="@string/password"

                android:textSize="18sp"
                android:textColor="#61677A"
                android:textColorHint="#61677A"
                android:padding="7dp"
                android:background="@drawable/edit"
                android:inputType="textPassword"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eyeu"
            android:layout_gravity="left"
            android:layout_marginLeft="40dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="15dp"
            android:textColor="#61677A"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:layout_marginTop="20dp"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:text="@string/login"
            android:textColor="#040303"
            android:textAllCaps="false"
            android:id="@+id/login"
            android:background="@drawable/border"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ifmuop"
            android:layout_marginTop="20dp"
            android:padding="7dp"
            android:id="@+id/IforgotPass"
            android:layout_marginBottom="190dp"
            android:textColor="#61677A"
            />
    </LinearLayout>
</RelativeLayout>