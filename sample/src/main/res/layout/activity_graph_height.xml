<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".graph_Height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@android:color/darker_gray">
            <ImageView
                android:id="@+id/txt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:src="@drawable/left"
                android:layout_marginLeft="5dp"
                />
            <TextView
                android:layout_marginLeft="12dp"

                android:id="@+id/height"
                android:layout_marginTop="10dp"
                android:paddingTop="10dp"
                android:paddingLeft="20dp"
                android:textColor="#040303"
                android:layout_width="110dp"
                android:layout_height="60dp"
                android:layout_alignParentLeft="true"
                android:backgroundTint="@android:color/darker_gray"
                android:text="Graph Height"
                android:textAllCaps="false"
                />
        </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        style="@style/Widget.AppCompat.Button"
        android:background="@drawable/borderforsetting"
        android:gravity="center|right"
        android:paddingRight="15dp"
        android:textColor="#637E76"
        android:textAllCaps="false">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="300 mg/dl"
            android:textSize="16dp"
            android:layout_marginRight="5dp"
            />
        <RadioButton
            android:id="@+id/min_hight"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            style="@style/Widget.AppCompat.Button"
            android:background="@drawable/borderforsetting"
            android:gravity="center|right"
            android:paddingRight="15dp"
            android:textColor="#637E76"
            android:textAllCaps="false">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="400 mg/dl"
                android:textSize="16dp"
                android:layout_marginRight="5dp"
                />
            <RadioButton
                android:id="@+id/max_hight"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


        </LinearLayout>
    </LinearLayout>

</RelativeLayout>